# ============================================================
# LinkedIn Outreach Automation — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Configuration ---
# Supported providers: openai, anthropic, nvidia, openrouter
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
# Override model from config.yaml (optional)
# LLM_MODEL=gpt-4o-mini

# --- Google Sheets ---
GOOGLE_SHEETS_CREDENTIALS_FILE=./credentials/service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here

# --- LinkedIn Credentials ---
# Used only for initial login; session persists via browser profile
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password-here

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Optional: Sender context for LLM personalization ---
# Brief description of who you are (used in note generation prompts)
SENDER_CONTEXT=Software engineer passionate about AI and distributed systems
SENDER_NAME=Your Name
